# mindmap 配置（复制本文件为 .env 后填写）
# 可以复用视觉桥的 .env：同样的键，直接复制即可

# 服务商：glm | deepseek | openai | dashscope | moonshot | siliconflow | ollama | custom
VISION_PROVIDER=glm

# API Key（Ollama 不需要）
VISION_API_KEY=你的API-Key

# 模型名
VISION_MODEL=glm-4.7

# 接口地址（custom 服务商必填，其余可留空用默认）
VISION_BASE_URL=

# 兼容别名（provider=glm 时可用，二选一）
# GLM_API_KEY=
